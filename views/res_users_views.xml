<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_mailbox_preferences" model="ir.ui.view">
        <field name="name">res.users.form.mailbox.preferences</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Email">
                    <field name="email_signature"/>
                    <field name="email_signature_external"/>
                    <field name="use_external_signature"/>
                </group>
                <group string="Mail Servers">
                    <field name="imap_server_id"/>
                    <field name="smtp_server_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_mailbox" model="ir.ui.view">
        <field name="name">res.users.preferences.form.mailbox</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="inside">
                <group string="Email Signature">
                    <field name="email_signature"/>
                    <field name="email_signature_external"/>
                    <field name="use_external_signature"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
