<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_personal_template_tree" model="ir.ui.view">
        <field name="name">mail.personal.template.list</field>
        <field name="model">mail.personal.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="subject"/>
                <field name="body_text"/>
                <field name="is_default"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mail_personal_template_form" model="ir.ui.view">
        <field name="name">mail.personal.template.form</field>
        <field name="model">mail.personal.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="subject"/>
                        <field name="is_default"/>
                        <field name="user_id" groups="base.group_no_one"/>
                    </group>
                    <label for="body" string="Body"/>
                    <field name="body" nolabel="1" widget="html"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mail_personal_template" model="ir.actions.act_window">
        <field name="name">Email Templates</field>
        <field name="res_model">mail.personal.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
