<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_mail_personal_folder" model="ir.actions.act_window">
        <field name="name">Personal Folders</field>
        <field name="res_model">mail.personal.folder</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new personal folder
            </p>
            <p>
                Personal folders help you organize your emails.
            </p>
        </field>
    </record>

    <record id="view_mail_personal_folder_tree" model="ir.ui.view">
        <field name="name">mail.personal.folder.list</field>
        <field name="model">mail.personal.folder</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="folder_type"/>
                <field name="message_count"/>
            </list>
        </field>
    </record>

    <record id="view_mail_personal_folder_form" model="ir.ui.view">
        <field name="name">mail.personal.folder.form</field>
        <field name="model">mail.personal.folder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="folder_type" readonly="is_system"/>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="is_system" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mail_personal_folder_search" model="ir.ui.view">
        <field name="name">mail.personal.folder.search</field>
        <field name="model">mail.personal.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="folder_type"/>
                <filter string="System Folders" name="system" domain="[('is_system', '=', True)]"/>
                <filter string="Custom Folders" name="custom" domain="[('is_system', '=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
