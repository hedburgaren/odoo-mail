<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_unified_workspace" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.unified.workspace</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Unified Workspace" string="Unified Workspace" name="unified_workspace">
                    <block title="Personal Mailbox Retention" name="unified_workspace_retention">
                        <setting help="Archive personal emails older than the configured threshold.">
                            <field name="unified_workspace_auto_archive_enabled"/>
                            <div class="content-group" invisible="not unified_workspace_auto_archive_enabled">
                                <div class="mt16">
                                    <label for="unified_workspace_auto_archive_days" string="Archive after" class="me-2"/>
                                    <field name="unified_workspace_auto_archive_days" class="oe_inline"/>
                                    <span class="ms-1">days</span>
                                </div>
                            </div>
                        </setting>
                        <setting help="Permanently delete personal emails older than the configured threshold.">
                            <field name="unified_workspace_gdpr_deletion_enabled"/>
                            <div class="content-group" invisible="not unified_workspace_gdpr_deletion_enabled">
                                <div class="mt16">
                                    <label for="unified_workspace_gdpr_deletion_days" string="Delete after" class="me-2"/>
                                    <field name="unified_workspace_gdpr_deletion_days" class="oe_inline"/>
                                    <span class="ms-1">days</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
