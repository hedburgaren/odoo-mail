<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pwa_push_subscription_tree" model="ir.ui.view">
        <field name="name">pwa.push.subscription.tree</field>
        <field name="model">pwa.push.subscription</field>
        <field name="arch" type="xml">
            <list string="Push-prenumerationer">
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="endpoint"/>
                <field name="active"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_pwa_push_subscription_form" model="ir.ui.view">
        <field name="name">pwa.push.subscription.form</field>
        <field name="model">pwa.push.subscription</field>
        <field name="arch" type="xml">
            <form string="Push-prenumeration">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                        <field name="endpoint"/>
                        <field name="p256dh" password="True"/>
                        <field name="auth" password="True"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pwa_push_subscription" model="ir.actions.act_window">
        <field name="name">Push-prenumerationer</field>
        <field name="res_model">pwa.push.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pwa_push_subscription"
        name="Push-prenumerationer"
        parent="base.menu_administration"
        action="action_pwa_push_subscription"
        sequence="200"
        groups="base.group_system"/>
</odoo>
