<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="unified_workspace.ReadingPane">
        <div class="o-unified-reading-pane d-flex flex-column h-100 flex-grow-1 bg-view overflow-hidden">
            <t t-if="message">
                <div class="o-unified-reading-pane-header p-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h4 class="m-0 fw-bold">
                            <t t-esc="message.name"/>
                            <span t-if="message.is_important" class="badge bg-danger ms-2">
                                <i class="fa fa-exclamation-circle me-1"/>Important
                            </span>
                        </h4>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="onReply">
                                <i class="fa fa-reply"/> Reply
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="onReplyAll">
                                <i class="fa fa-reply-all"/> Reply All
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="onForward">
                                <i class="fa fa-share"/> Forward
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="onToggleStar">
                                <i t-att-class="message.is_starred ? 'fa fa-star text-warning' : 'fa fa-star-o'"/>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="onToggleImportant">
                                <i t-att-class="message.is_important ? 'fa fa-exclamation-circle text-danger' : 'fa fa-exclamation-circle text-muted'"/>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" t-on-click="onTrash">
                                <i class="fa fa-trash"/> Delete
                            </button>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="fw-bold me-2">From:</span>
                        <span t-esc="message.email_from"/>
                    </div>
                    <div t-if="message.email_to" class="d-flex align-items-center mb-1">
                        <span class="fw-bold me-2">To:</span>
                        <span t-esc="message.email_to"/>
                    </div>
                    <div t-if="message.email_cc" class="d-flex align-items-center mb-1">
                        <span class="fw-bold me-2">CC:</span>
                        <span t-esc="message.email_cc"/>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="fw-bold me-2">Date:</span>
                        <span t-esc="formatDateTime(message.date)"/>
                    </div>
                </div>

                <div class="o-unified-reading-pane-actions p-2 border-bottom d-flex gap-2">
                    <button t-if="isDraft" class="btn btn-sm btn-outline-primary" t-on-click="onEditDraft">
                        <i class="fa fa-pencil me-1"/> Edit Draft
                    </button>
                    <button t-else="" class="btn btn-sm btn-outline-primary" t-on-click="onCreateLead">
                        <i class="fa fa-briefcase me-1"/> Create Lead
                    </button>
                    <button t-if="!isDraft" class="btn btn-sm btn-outline-primary" t-on-click="onCreateTask">
                        <i class="fa fa-check-square-o me-1"/> Create Task
                    </button>
                    <button t-if="!isDraft" class="btn btn-sm btn-outline-primary" t-on-click="onBookMeeting">
                        <i class="fa fa-calendar-plus-o me-1"/> Book Meeting
                    </button>
                    <button t-if="!isDraft" class="btn btn-sm btn-outline-primary" t-on-click="onLogActivity">
                        <i class="fa fa-clock-o me-1"/> Log Activity
                    </button>
                    <button t-if="!isDraft and message.partner_id" class="btn btn-sm btn-outline-primary" t-on-click="onViewContact">
                        <i class="fa fa-user me-1"/> View Contact
                    </button>
                    <button t-if="!isDraft and message.attachment_ids?.length" class="btn btn-sm btn-outline-primary" t-on-click="onSaveAttachmentsToDms">
                        <i class="fa fa-folder-open me-1"/> Save to DMS
                    </button>
                    <button t-if="!isDraft and message.is_important" class="btn btn-sm btn-outline-primary" t-on-click="onSaveToKnowledge">
                        <i class="fa fa-book me-1"/> Save to Knowledge
                    </button>
                </div>

                <div t-if="hasTask" class="o-unified-reading-pane-timer p-2 border-bottom d-flex align-items-center gap-2">
                    <i class="fa fa-clock-o text-muted"/>
                    <span class="font-monospace fw-bold" t-esc="formatElapsed(totalElapsedSeconds)"/>
                    <button t-if="!message.timer_active" class="btn btn-sm btn-outline-success" t-on-click="onTimerStart">
                        <i class="fa fa-play me-1"/> Start
                    </button>
                    <button t-else="" class="btn btn-sm btn-outline-warning" t-on-click="onTimerStop">
                        <i class="fa fa-stop me-1"/> Stop
                    </button>
                    <button class="btn btn-sm btn-outline-primary" t-on-click="onLogTime">
                        <i class="fa fa-save me-1"/> Log Time
                    </button>
                </div>

                <div t-if="hasCalendarEvent" class="o-unified-reading-pane-event p-3 border-bottom bg-light">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-calendar-check-o me-2 text-primary"/>
                        <strong>Meeting invitation</strong>
                        <span t-if="message.calendar_my_rsvp" class="badge ms-2" t-att-class="{
                            'bg-success': message.calendar_my_rsvp === 'accepted',
                            'bg-warning text-dark': message.calendar_my_rsvp === 'tentative',
                            'bg-danger': message.calendar_my_rsvp === 'declined',
                            'bg-secondary': message.calendar_my_rsvp === 'needsAction',
                        }">
                            <t t-esc="message.calendar_my_rsvp"/>
                        </span>
                    </div>
                    <h6 class="mb-1" t-esc="calendarEvent.name"/>
                    <div class="text-muted small mb-2">
                        <div t-if="calendarEvent.start">
                            <i class="fa fa-clock-o me-1"/>
                            <t t-esc="formatEventDate(calendarEvent.start)"/>
                            <t t-if="calendarEvent.stop"> - <t t-esc="formatEventDate(calendarEvent.stop)"/></t>
                        </div>
                        <div t-if="calendarEvent.location">
                            <i class="fa fa-map-marker me-1"/>
                            <t t-esc="calendarEvent.location"/>
                        </div>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-success" t-on-click="onAcceptEvent" t-att-disabled="message.calendar_my_rsvp === 'accepted'">
                            <i class="fa fa-check me-1"/> Accept
                        </button>
                        <button class="btn btn-warning" t-on-click="onTentativeEvent" t-att-disabled="message.calendar_my_rsvp === 'tentative'">
                            <i class="fa fa-question me-1"/> Tentative
                        </button>
                        <button class="btn btn-danger" t-on-click="onDeclineEvent" t-att-disabled="message.calendar_my_rsvp === 'declined'">
                            <i class="fa fa-times me-1"/> Decline
                        </button>
                    </div>
                </div>

                <div class="o-unified-reading-pane-body flex-grow-1 overflow-auto p-3">
                    <div t-out="message.body"/>
                    <AttachmentList attachments="message.attachment_ids" linkedRecord="linkedRecord" onSaveToRecord.bind="onSaveAttachments"/>
                </div>

                <ThreadPanel threadMessages="state.threadMessages" selectedMessageId="mailbox.selectedMessageId" onSelectMessage.bind="(id) => mailbox.selectMessage(id)"/>

                <ContactCard partnerId="message.partner_id?.[0]"/>
            </t>
            <div t-else="" class="d-flex align-items-center justify-content-center h-100 text-muted">
                Select an email to read it.
            </div>
        </div>
    </t>
</templates>
