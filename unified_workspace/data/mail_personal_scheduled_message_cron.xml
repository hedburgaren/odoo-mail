<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_send_scheduled_personal_emails" model="ir.cron">
        <field name="name">Personal Mailbox: Send scheduled emails</field>
        <field name="model_id" ref="model_mail_personal_scheduled_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due_messages()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
